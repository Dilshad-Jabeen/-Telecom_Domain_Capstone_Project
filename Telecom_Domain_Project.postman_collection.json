          "name": "1_Add New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//Test to check if the response status code is 201\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Capture the token from the response and save to environment variable\r",
                  "pm.test(\"Token is present in response\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.token).to.exist;\r",
                  "    pm.environment.set(\"Token Data\", jsonData.token);\r",
                  "    console.log(\"Token captured and saved to environment variable 'Token Data': \" + jsonData.token);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
